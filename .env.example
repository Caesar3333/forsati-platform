# Forsati Platform Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env file with actual secrets!

# ===========================================
# MARKET / REGIONAL SETTINGS (Jordan First)
# ===========================================
MARKET_DEFAULT=jo
ENABLED_MARKETS=jo,sa,ae
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en
DEFAULT_CURRENCY=JOD
DEFAULT_TIMEZONE=Asia/Amman

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forsati_db
POSTGRES_USER=forsati_user
POSTGRES_PASSWORD=

# ===========================================
# STRAPI (Headless CMS)
# ===========================================
STRAPI_URL=http://localhost:1337
STRAPI_ADMIN_URL=http://localhost:1337/admin
STRAPI_API_TOKEN=
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=

# ===========================================
# MINIO (S3-Compatible Storage)
# ===========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_RESUMES=forsati-resumes
MINIO_BUCKET_MEDIA=forsati-media

# ===========================================
# KEYCLOAK (IAM / SSO)
# ===========================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=forsati
KEYCLOAK_CLIENT_ID=forsati-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# ===========================================
# INGESTOR SERVICE (Resume Parser)
# ===========================================
INGESTOR_URL=http://localhost:8000
INGESTOR_API_KEY=

# ===========================================
# ELASTICSEARCH / TYPESENSE (Search)
# ===========================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# ===========================================
# JITSI (Video Conferencing)
# ===========================================
JITSI_URL=http://localhost:8443
JITSI_APP_ID=
JITSI_APP_SECRET=

# ===========================================
# AI / ML SERVICES
# ===========================================
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
WHISPER_MODEL=base

# ===========================================
# RASA / BOTPRESS (Chatbot)
# ===========================================
RASA_URL=http://localhost:5005
BOTPRESS_URL=http://localhost:3000

# ===========================================
# FRONTEND (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:1337/api
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=forsati
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=forsati-app

# ===========================================
# SECURITY
# ===========================================
SESSION_SECRET=
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:1337

# ===========================================
# LOGGING / MONITORING
# ===========================================
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
