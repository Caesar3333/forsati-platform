# Environment Variables Documentation

# ============================================
# Application
# ============================================

# Base URL for the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL for backend services
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Application name
NEXT_PUBLIC_APP_NAME=Forsati

# Default locale (ar or en)
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Default market (jo, sa, ae)
NEXT_PUBLIC_MARKET_DEFAULT=jo

# Enabled markets (comma-separated)
ENABLED_MARKETS=jo,sa,ae

# ============================================
# Authentication (NextAuth.js)
# ============================================

# NextAuth URL (must match your deployment URL)
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret for JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# ============================================
# Keycloak SSO (OAuth/OIDC)
# ============================================

# Keycloak server URL
KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name
KEYCLOAK_REALM=forsati

# Keycloak client ID
KEYCLOAK_CLIENT_ID=forsati-web

# Keycloak client secret (confidential client)
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret

# ============================================
# Google OAuth (Optional)
# ============================================

# Google OAuth client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Backend Services
# ============================================

# Strapi CMS URL
STRAPI_URL=http://localhost:1337

# Strapi API token (readonly)
STRAPI_API_TOKEN=your-strapi-readonly-token

# Ingestor service URL (CV parsing)
INGESTOR_URL=http://localhost:8000
INGESTOR_API_URL=http://localhost:8000

# Ingestor API key
INGESTOR_API_KEY=your-ingestor-api-key

# ============================================
# Storage (MinIO/S3)
# ============================================

# MinIO/S3 endpoint
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000

# MinIO access key
MINIO_ACCESS_KEY=minioadmin

# MinIO secret key
MINIO_SECRET_KEY=minioadmin

# MinIO bucket for uploads
MINIO_BUCKET=forsati-uploads

# MinIO bucket for resumes (CV scan)
MINIO_RESUME_BUCKET=forsati-resumes

# Whether to use SSL for MinIO
MINIO_USE_SSL=false

# ============================================
# Database
# ============================================

# PostgreSQL connection URL
DATABASE_URL=postgresql://forsati:forsati@localhost:5432/forsati

# PostgreSQL individual vars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=forsati
POSTGRES_PASSWORD=forsati
POSTGRES_DB=forsati

# ============================================
# Redis (Cache & Sessions)
# ============================================

# Redis connection URL
REDIS_URL=redis://localhost:6379

# ============================================
# Search (Typesense)
# ============================================

# Typesense host
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=forsati_typesense_key

# ============================================
# AI Services
# ============================================

# OpenAI API key (for CV parsing and matching)
OPENAI_API_KEY=sk-your-openai-api-key

# HuggingFace API key (alternative to OpenAI)
HUGGINGFACE_API_KEY=hf_your-huggingface-api-key

# ============================================
# Analytics & Monitoring
# ============================================

# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Segment write key (optional)
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your-segment-write-key

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ============================================
# Feature Flags
# ============================================

# Enable voice CV scan feature
NEXT_PUBLIC_FEATURE_VOICE_SCAN=true

# Enable photo CV scan feature  
NEXT_PUBLIC_FEATURE_PHOTO_SCAN=true

# Enable AI job matching
NEXT_PUBLIC_FEATURE_AI_MATCHING=true

# Enable video interviews
NEXT_PUBLIC_FEATURE_VIDEO_INTERVIEW=false

# ============================================
# Email (Resend/SMTP)
# ============================================

# Email provider API key
RESEND_API_KEY=re_xxxxxxxxxxxx

# From email address
EMAIL_FROM=noreply@forsati.jo

# ============================================
# Rate Limiting
# ============================================

# Upstash Redis URL for rate limiting
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================
# Development Only
# ============================================

# Skip auth for development
# SKIP_AUTH=true

# Mock API responses
# MOCK_API=true

# Debug mode
# DEBUG=true
